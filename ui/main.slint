// Slint Material 3 main window with navigation rail

import { MaterialWindow, NavigationRail, NavigationItem, AppBar, FilledButton, ElevatedCard,
         FilledCard, OutlinedCard, TextButton, OutlineButton, ListView, ListTile,
         HorizontalDivider, VerticalDivider, Icon, IconButton, MaterialText,
         TextField, CheckBox, Switch, SnackBar, ScrollView } from "@material";
import { HomeView, HomeViewAdapter } from "./pages/home.slint";
import { ProfileView, ProfileViewAdapter } from "./pages/profile.slint";
import { SettingsView, SettingsViewAdapter } from "./pages/settings.slint";
import { MainAdapter } from "./components/main_adapter.slint";

export { MainAdapter }

export component MainWindow inherits MaterialWindow {
    preferred-width: 800px;
    preferred-height: 560px;
    min-width: 360px;
    min-height: 360px;
    background: MainAdapter.background;

    in property <[NavigationItem]> nav-items: [
        { icon: @image-url("icons/home.svg"), text: "Home" },
        { icon: @image-url("icons/profile.svg"), text: "Profiles" },
        { icon: @image-url("icons/settings.svg"), text: "Settings" },
    ];

    VerticalLayout {
        AppBar {
            title: "Slint Clash";
        }

        HorizontalLayout {
            NavigationRail {
                items: root.nav-items;
                current-index <=> MainAdapter.current-page;
            }

            ScrollView {
                if MainAdapter.current-page == 0: HomeView {
                }
                if MainAdapter.current-page == 1: ProfileView {
                }
                if MainAdapter.current-page == 2: SettingsView {
                }
            }
        }
    }
}
