// Profile page: config profile selection and management

import { Typography, ElevatedCard, FilledButton, OutlineButton, TextButton, TextField,
         MaterialText, HorizontalDivider, Icon, ScrollView } from "@material";
import { MainAdapter } from "../components/main_adapter.slint";

export { MainAdapter as ProfileViewAdapter }

component ProfileActions {
    callback add-subscription();

    HorizontalLayout {
        spacing: 8px;
        OutlineButton {
            height: 40px;
            text: "Add Subscription";
            enabled: !MainAdapter.core-busy;
            horizontal-stretch: 0;
            clicked => {
                root.add-subscription();
            }
        }
        OutlineButton {
            height: 40px;
            text: "Reload Config";
            enabled: !MainAdapter.core-busy;
            horizontal-stretch: 0;
            clicked => {
                MainAdapter.reload-config();
            }
        }
    }
}

export component ProfileView {
    width: 100%;
    height: 100%;

    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 16px;
            width: 100%;

            if root.width >= 560px: HorizontalLayout {
                height: 48px;
                spacing: 12px;
                alignment: center;
                width: 100%;
                MaterialText {
                    text: "Profiles";
                    style: Typography.title_large;
                }
                Rectangle { horizontal-stretch: 1; }
                ProfileActions {
                    add-subscription => {
                        MainAdapter.show-import-ui = true;
                    }
                }
            }

            if root.width < 560px: VerticalLayout {
                spacing: 8px;
                MaterialText {
                    text: "Profiles";
                    style: Typography.title_large;
                }
                ProfileActions {
                    add-subscription => {
                        MainAdapter.show-import-ui = true;
                    }
                }
            }

            if MainAdapter.show-import-ui: ElevatedCard {
                width: 100%;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    MaterialText {
                        text: "Import Subscription";
                        style: Typography.title_medium;
                    }

                    TextField {
                        label: "Profile name";
                        text <=> MainAdapter.import-name;
                    }

                    TextField {
                        label: "Subscription URL";
                        text <=> MainAdapter.import-url;
                    }

                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        TextButton {
                            text: "Cancel";
                            enabled: !MainAdapter.core-busy;
                            clicked => {
                                MainAdapter.cancel-import();
                            }
                        }
                        FilledButton {
                            width: 120px;
                            text: MainAdapter.core-busy ? "Importing…" : "Import";
                            enabled: !MainAdapter.core-busy;
                            clicked => {
                                MainAdapter.import-profile(
                                    MainAdapter.import-name,
                                    MainAdapter.import-url
                                );
                            }
                        }
                    }
                }
            }

            ElevatedCard {
                width: 100%;
                VerticalLayout {
                    spacing: 12px;
                    padding: 20px;
                    width: 100%;

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        width: 100%;

                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: #303238;
                            Icon {
                                source: @image-url("../icons/emblem-default.svg");
                                width: 28px;
                                height: 28px;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            MaterialText {
                                text: "Active Profile";
                                style: Typography.label_medium;
                                opacity: 0.6;
                            }
                            MaterialText {
                                text: MainAdapter.active-profile == "" ? "None" : MainAdapter.active-profile;
                                style: Typography.title_medium;
                            }
                        }
                    }
                }
            }

            if !MainAdapter.profiles-loaded || MainAdapter.profiles.length == 0: ElevatedCard {
                width: 100%;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 32px;
                    width: 100%;

                    Icon {
                        source: @image-url("../icons/folder.svg");
                        width: 48px;
                        height: 48px;
                    }
                    MaterialText {
                        text: "No profiles found";
                        style: Typography.title_small;
                        horizontal-alignment: center;
                    }
                    MaterialText {
                        text: "Add YAML configuration files to your config directory.";
                        style: Typography.body_medium;
                        horizontal-alignment: center;
                        opacity: 0.6;
                    }
                }
            }

            if MainAdapter.profiles-loaded && MainAdapter.profiles.length > 0: ElevatedCard {
                width: 100%;
                VerticalLayout {
                    spacing: 0px;
                    padding: 20px;
                    width: 100%;

                    HorizontalLayout {
                        spacing: 8px;
                        width: 100%;
                        Icon {
                            source: @image-url("../icons/folder-open.svg");
                            width: 20px;
                            height: 20px;
                        }
                        MaterialText {
                            text: "Available Profiles";
                            style: Typography.title_small;
                        }
                    }

                    HorizontalDivider { width: 100%; }

                    for profile[idx] in MainAdapter.profiles: VerticalLayout {
                        width: 100%;
                        HorizontalLayout {
                            spacing: 12px;
                            padding-left: 4px;
                            padding-right: 4px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: center;
                            width: 100%;

                            Icon {
                                source: profile.name == MainAdapter.active-profile ? @image-url("../icons/emblem-default.svg") : @image-url("../icons/folder.svg");
                                width: 20px;
                                height: 20px;
                            }

                            MaterialText {
                                text: profile.name;
                                style: Typography.body_medium;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if profile.is-subscription: TextButton {
                                text: "Update";
                                enabled: !MainAdapter.core-busy;
                                clicked => {
                                    MainAdapter.update-profile(profile.name);
                                }
                            }

                            if MainAdapter.active-profile == profile.name: MaterialText {
                                text: "Selected";
                                style: Typography.label_medium;
                                opacity: 0.6;
                            }

                            if MainAdapter.active-profile != profile.name: TextButton {
                                text: "Select";
                                enabled: !MainAdapter.core-busy;
                                clicked => {
                                    MainAdapter.select-profile(profile.name);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
