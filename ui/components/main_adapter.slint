// Global adapter for main window state and bridge to Rust backend

import { MaterialPalette } from "@material";

export struct ProfileItem {
    name: string,
    is-subscription: bool,
}

export struct ProxyGroupItem {
    name: string,
    kind: string,
    selected: string,
    count: int,
}

export struct ProxyNodeItem {
    name: string,
    kind: string,
    delay: string,
    alive: bool,
    selected: bool,
}

export global MainAdapter {
    in-out property <int> current-page: 0;
    in-out property <brush> background: MaterialPalette.background;

    // Mihomo core state. System proxy and TUN will be separate controls.
    in-out property <bool> core-running;
    in-out property <bool> core-busy;
    in-out property <string> status-message: "Core is stopped";
    in-out property <string> error-message;
    in-out property <string> clash-version;
    in-out property <int> clash-mode-index: 0;
    in-out property <string> traffic-upload: "—";
    in-out property <string> traffic-download: "—";

    // Profile state
    in-out property <string> active-profile;
    in-out property <[ProfileItem]> profiles;
    in-out property <bool> profiles-loaded;
    in-out property <bool> show-import-ui;
    in-out property <string> import-name;
    in-out property <string> import-url;

    // Proxy groups and the nodes for the currently selected group
    in-out property <[ProxyGroupItem]> proxy-groups;
    in-out property <[ProxyNodeItem]> proxy-nodes;
    in-out property <string> active-proxy-group;

    // Settings state — persisted values
    in-out property <string> setting-binary-path;
    in-out property <string> setting-config-dir;
    in-out property <int> setting-api-port: 9090;
    in-out property <string> setting-api-port-text: "9090";
    in-out property <string> setting-api-secret;

    // Settings state — editing UI
    in-out property <int> editing-field-index: -1;
    in-out property <string> edit-value;
    in-out property <bool> show-edit-ui;
    in-out property <bool> traffic-pulse;

    callback toggle-core();
    callback set-clash-mode(int);
    callback select-profile(string);
    callback reload-config();
    callback import-profile(string, string);
    callback update-profile(string);
    callback cancel-import();
    callback refresh-proxies();
    callback select-proxy-group(string);
    callback select-proxy(string, string);
    callback test-proxy-delay(string, string);
    callback start-edit(int);
    callback save-setting(int, string);
    callback cancel-edit();
    callback dismiss-error();
}
