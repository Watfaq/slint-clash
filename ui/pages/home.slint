// Home page: Mihomo core status and traffic statistics.

import { Typography, ElevatedCard, FilledCard, FilledButton, OutlineButton, SegmentedButton,
         MaterialText, HorizontalDivider, Icon, ScrollView } from "@material";
import { MainAdapter } from "../components/main_adapter.slint";

export { MainAdapter as HomeViewAdapter }

export component HomeView {
    width: 100%;
    height: 100%;

    ScrollView {
        // Off state
        if !MainAdapter.core-running: VerticalLayout {
            alignment: center;
            spacing: 20px;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 36px;
            padding-bottom: 36px;

            Rectangle {
                width: 88px;
                height: 88px;
                border-radius: 44px;
                background: #303238;
                HorizontalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("../icons/network-wireless-disabled.svg");
                        width: 56px;
                        height: 56px;
                    }
                }
            }

            MaterialText {
                text: MainAdapter.core-busy ? "Starting Mihomo…" : "Mihomo core is stopped";
                style: Typography.headline_small;
                horizontal-alignment: center;
            }

            MaterialText {
                text: MainAdapter.core-busy
                    ? "Waiting for the local control API to become ready."
                    : "Start the core before selecting proxies or monitoring traffic.";
                style: Typography.body_medium;
                horizontal-alignment: center;
                opacity: 0.6;
            }

            HorizontalLayout {
                alignment: center;
                FilledButton {
                    width: 180px;
                    text: MainAdapter.core-busy ? "Starting…" : "Start Core";
                    enabled: !MainAdapter.core-busy;
                    clicked => {
                        MainAdapter.toggle-core();
                    }
                }
            }
        }

        // On state
        if MainAdapter.core-running: VerticalLayout {
            padding: 16px;
            spacing: 16px;
            width: 100%;

            // Core status card
            ElevatedCard {
                width: 100%;
                VerticalLayout {
                    spacing: 16px;
                    padding: 20px;
                    width: 100%;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Icon {
                            source: @image-url("../icons/network-wireless.svg");
                            width: 28px;
                            height: 28px;
                        }

                        MaterialText {
                            text: "Mihomo Core";
                            style: Typography.title_medium;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Pulsing status dot
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: #4caf50;
                        }
                        MaterialText {
                            text: MainAdapter.core-busy ? "Stopping…" : "Running";
                            style: Typography.body_medium;
                            opacity: 0.7;
                        }
                    }

                    HorizontalDivider { width: 100%; }

                    if MainAdapter.clash-version != "": HorizontalLayout {
                        spacing: 8px;
                        width: 100%;
                        MaterialText {
                            text: "Clash Version";
                            style: Typography.label_medium;
                            opacity: 0.6;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        MaterialText {
                            text: MainAdapter.clash-version;
                            style: Typography.body_medium;
                        }
                    }

                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        OutlineButton {
                            text: MainAdapter.core-busy ? "Stopping…" : "Stop Core";
                            enabled: !MainAdapter.core-busy;
                            horizontal-stretch: 0;
                            clicked => {
                                MainAdapter.toggle-core();
                            }
                        }
                    }

                    MaterialText {
                        text: MainAdapter.status-message;
                        style: Typography.body_small;
                        opacity: 0.6;
                    }
                }
            }

            ElevatedCard {
                width: 100%;
                VerticalLayout {
                    spacing: 14px;
                    padding: 20px;

                    MaterialText {
                        text: "Proxy Mode";
                        style: Typography.title_medium;
                    }

                    SegmentedButton {
                        items: [
                            { text: "Rule" },
                            { text: "Global" },
                            { text: "Direct" },
                        ];
                        current-index: MainAdapter.clash-mode-index;
                        enabled: !MainAdapter.core-busy;
                        index-changed(index) => {
                            MainAdapter.set-clash-mode(index);
                        }
                    }
                }
            }

            // Traffic statistics card
            ElevatedCard {
                width: 100%;
                VerticalLayout {
                    spacing: 16px;
                    padding: 20px;
                    width: 100%;

                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            source: @image-url("../icons/utilities-system-monitor.svg");
                            width: 20px;
                            height: 20px;
                        }
                        MaterialText {
                            text: "Statistics";
                            style: Typography.title_medium;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        width: 100%;

                        FilledCard {
                            width: 100%;
                            VerticalLayout {
                                spacing: 8px;
                                padding: 16px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        source: @image-url("../icons/go-up.svg");
                                        width: 16px;
                                        height: 16px;
                                    }
                                    MaterialText {
                                        text: "Upload";
                                        style: Typography.label_medium;
                                        opacity: 0.6;
                                    }
                                }
                                MaterialText {
                                    text: MainAdapter.traffic-upload;
                                    style: Typography.title_medium;
                                    color: MainAdapter.traffic-pulse ? #a5d6a7 : #81c784;
                                    animate color { duration: 300ms; easing: ease-in-out; }
                                }
                            }
                        }

                        FilledCard {
                            width: 100%;
                            VerticalLayout {
                                spacing: 8px;
                                padding: 16px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        source: @image-url("../icons/go-down.svg");
                                        width: 16px;
                                        height: 16px;
                                    }
                                    MaterialText {
                                        text: "Download";
                                        style: Typography.label_medium;
                                        opacity: 0.6;
                                    }
                                }
                                MaterialText {
                                    text: MainAdapter.traffic-download;
                                    style: Typography.title_medium;
                                    color: MainAdapter.traffic-pulse ? #81d4fa : #4fc3f7;
                                    animate color { duration: 300ms; easing: ease-in-out; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
