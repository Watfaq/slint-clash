import { MaterialWindow, MaterialText, Typography, MaterialPalette, Icon,
         LinearProgressIndicator, SnackBar } from "@material";
import { HomeView } from "./pages/home.slint";
import { ProxiesView } from "./pages/proxies.slint";
import { ProfileView } from "./pages/profile.slint";
import { SettingsView } from "./pages/settings.slint";
import { MainAdapter } from "./components/main_adapter.slint";

export { MainAdapter }

component NavigationEntry {
    in property <image> icon;
    in property <string> label;
    in property <int> page;
    property <bool> selected: MainAdapter.current-page == root.page;

    width: 72px;
    height: 64px;

    Rectangle {
        border-radius: 18px;
        background: root.selected
            ? MaterialPalette.primary-container
            : touch.has-hover
                ? MaterialPalette.surface-container-high
                : transparent;

        animate background { duration: 140ms; }

        VerticalLayout {
            padding-top: 9px;
            padding-bottom: 8px;
            spacing: 4px;
            alignment: center;

            Icon {
                source: root.icon;
                width: 22px;
                height: 22px;
                colorize: root.selected
                    ? MaterialPalette.on-primary-container
                    : MaterialPalette.on-surface-variant;
            }

            MaterialText {
                text: root.label;
                style: Typography.label-small;
                color: root.selected
                    ? MaterialPalette.on-primary-container
                    : MaterialPalette.on-surface-variant;
                horizontal-alignment: center;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                MainAdapter.current-page = root.page;
            }
        }
    }
}

export component MainWindow inherits MaterialWindow {
    title: "Slint Clash";
    preferred-width: 920px;
    preferred-height: 640px;
    min-width: 600px;
    min-height: 440px;
    background: MaterialPalette.surface-container-lowest;

    private property <string> snackbar-message <=> MainAdapter.error-message;

    changed snackbar-message => {
        if root.snackbar-message != "" {
            error-snackbar.show();
        }
    }

    VerticalLayout {
        Rectangle {
            height: 68px;
            background: MaterialPalette.surface-container-low;

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                spacing: 14px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 12px;
                        background: MaterialPalette.primary-container;

                        Icon {
                            source: @image-url("icons/proxy.svg");
                            width: 22px;
                            height: 22px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: MaterialPalette.on-primary-container;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 0px;
                    alignment: center;
                    horizontal-stretch: 0;

                    MaterialText {
                        text: "Slint Clash";
                        style: Typography.title-medium;
                    }
                    MaterialText {
                        text: "Mihomo desktop client";
                        style: Typography.label-small;
                        color: MaterialPalette.on-surface-variant;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    Rectangle {
                        height: 34px;
                        border-radius: 17px;
                        background: MainAdapter.core-running
                            ? #173b2b
                            : MaterialPalette.surface-container-high;
                        min-width: status-layout.min-width;

                        status-layout := HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 13px;
                            spacing: 8px;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: MainAdapter.core-running ? #59d98e : #8d9199;
                            }
                            MaterialText {
                                text: MainAdapter.core-busy
                                    ? "Working"
                                    : MainAdapter.core-running ? "Core running" : "Core stopped";
                                style: Typography.label-medium;
                                color: MainAdapter.core-running
                                    ? #b8f5cf
                                    : MaterialPalette.on-surface-variant;
                            }
                        }
                    }
                }
            }
        }

        if MainAdapter.core-busy: LinearProgressIndicator {
            indeterminate: true;
            progress: 0.5;
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 96px;
                background: MaterialPalette.surface-container-low;

                VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 20px;
                    spacing: 10px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: center;
                        NavigationEntry {
                            icon: @image-url("icons/home.svg");
                            label: "Home";
                            page: 0;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        NavigationEntry {
                            icon: @image-url("icons/proxy.svg");
                            label: "Proxies";
                            page: 1;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        NavigationEntry {
                            icon: @image-url("icons/profile.svg");
                            label: "Profiles";
                            page: 2;
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        alignment: center;
                        NavigationEntry {
                            icon: @image-url("icons/settings.svg");
                            label: "Settings";
                            page: 3;
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: MaterialPalette.surface-container-lowest;
                clip: true;

                home := HomeView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    x: MainAdapter.current-page == 0 ? 0px : parent.width;
                    opacity: MainAdapter.current-page == 0 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-out; }
                    animate opacity { duration: 160ms; easing: ease-in-out; }
                }
                proxies := ProxiesView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    x: MainAdapter.current-page == 1 ? 0px : parent.width;
                    opacity: MainAdapter.current-page == 1 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-out; }
                    animate opacity { duration: 160ms; easing: ease-in-out; }
                }
                profile := ProfileView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    x: MainAdapter.current-page == 2 ? 0px : parent.width;
                    opacity: MainAdapter.current-page == 2 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-out; }
                    animate opacity { duration: 160ms; easing: ease-in-out; }
                }
                settings := SettingsView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    x: MainAdapter.current-page == 3 ? 0px : parent.width;
                    opacity: MainAdapter.current-page == 3 ? 1.0 : 0.0;
                    animate x { duration: 220ms; easing: ease-out; }
                    animate opacity { duration: 160ms; easing: ease-in-out; }
                }
            }
        }

    }

    error-snackbar := SnackBar {
        text: root.snackbar-message;
        action-text: "Dismiss";
        has-close-button: false;
        action-clicked => {
            MainAdapter.dismiss-error();
        }
    }
}
