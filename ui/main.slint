// Slint Material 3 main window with navigation rail

import { MaterialWindow, NavigationRail, NavigationItem, AppBar, LinearProgressIndicator,
         MaterialText, TextButton } from "@material";
import { HomeView, HomeViewAdapter } from "./pages/home.slint";
import { ProfileView, ProfileViewAdapter } from "./pages/profile.slint";
import { SettingsView, SettingsViewAdapter } from "./pages/settings.slint";
import { MainAdapter } from "./components/main_adapter.slint";

export { MainAdapter }

export component MainWindow inherits MaterialWindow {
    title: "Slint Clash";
    preferred-width: 800px;
    preferred-height: 560px;
    min-width: 360px;
    min-height: 360px;
    background: MainAdapter.background;

    in property <[NavigationItem]> nav-items: [
        { icon: @image-url("icons/home.svg"), text: "Home" },
        { icon: @image-url("icons/profile.svg"), text: "Profiles" },
        { icon: @image-url("icons/settings.svg"), text: "Settings" },
    ];

    VerticalLayout {
        AppBar {
            title: "Slint Clash";
        }

        if MainAdapter.core-busy: LinearProgressIndicator {
            indeterminate: true;
            progress: 0.5;
        }

        HorizontalLayout {
            NavigationRail {
                items: root.nav-items;
                current-index <=> MainAdapter.current-page;
            }

            // Content fills remaining space — pages stacked with slide+fade transitions
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                clip: true;

                home := HomeView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    x: MainAdapter.current-page == 0 ? 0px : parent.width;
                    opacity: MainAdapter.current-page == 0 ? 1.0 : 0.0;
                    animate x { duration: 250ms; easing: ease-out; }
                    animate opacity { duration: 200ms; easing: ease-in-out; }
                }
                profile := ProfileView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    x: MainAdapter.current-page == 1 ? 0px : parent.width;
                    opacity: MainAdapter.current-page == 1 ? 1.0 : 0.0;
                    animate x { duration: 250ms; easing: ease-out; }
                    animate opacity { duration: 200ms; easing: ease-in-out; }
                }
                settings := SettingsView {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    x: MainAdapter.current-page == 2 ? 0px : parent.width;
                    opacity: MainAdapter.current-page == 2 ? 1.0 : 0.0;
                    animate x { duration: 250ms; easing: ease-out; }
                    animate opacity { duration: 200ms; easing: ease-in-out; }
                }
            }
        }

        if MainAdapter.error-message != "": Rectangle {
            height: 56px;
            background: #7f1d1d;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 12px;
                alignment: center;

                MaterialText {
                    text: MainAdapter.error-message;
                    color: white;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                TextButton {
                    text: "Dismiss";
                    inverse: true;
                    clicked => {
                        MainAdapter.dismiss-error();
                    }
                }
            }
        }
    }
}
